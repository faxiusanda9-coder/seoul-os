YOUTUBE_API_KEY=
TICKETMASTER_API_KEY=
# Instagram: calling app user's professional account ID, not an artist handle.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN_EXPIRES_AT=
INSTAGRAM_GRAPH_VERSION=v26.0
# Per-artist OAuth grants. Never put credentials in data/ or public/.
TIKTOK_CREDENTIALS_JSON={}
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional fine-grained repository Secrets:write token for durable rotation.
SOCIAL_SECRET_WRITER_TOKEN=
# Optional comma-separated verified source IDs intentionally kept manual-only.
SOCIAL_DISABLED_SOURCES=
# Third-party TikTok: disabled until free-only account and use permission verified.
BRIGHT_DATA_API_KEY=
BRIGHTDATA_TIKTOK_ENABLED=false
# Separate production collection approval. Probe does not need this switch.
BRIGHTDATA_TIKTOK_SCHEDULE_ENABLED=false
BRIGHTDATA_ZERO_COST_APPROVAL_JSON=
# Live calls run in Actions only. Explicit one-time remote ledger bootstrap.
BRIGHTDATA_BUDGET_INITIALIZE=false
