{
  "name": "seoul-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/stage-public-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/stage-public-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "sync:youtube": "node scripts/youtube-sync.mjs",
    "sync:calendar": "node scripts/events/sync.mjs",
    "calendar:coverage": "node scripts/events/coverage.mjs",
    "calendar:pilot:youtube": "node scripts/events/youtube-live-pilot.mjs",
    "event:manual": "node scripts/events/manual-cli.mjs",
    "event:remove": "node scripts/events/remove-event.mjs",
    "test:calendar": "node --test tests/calendar-engine.test.mjs",
    "test:sync": "node --test tests/youtube-sync.test.mjs",
    "test:i18n": "node --test tests/locales.test.mjs",
    "test:taxonomy": "node --test tests/content-taxonomy.test.mjs",
    "test:official": "node --test tests/official-intelligence.test.mjs",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' vite.config.ts index.html README.md .github/workflows/deploy.yml",
    "sync:social": "node scripts/social-sync/index.mjs validate",
    "social:import": "node scripts/social-sync/index.mjs import",
    "test:social": "node --test tests/social-media.test.mjs",
    "monitor:freshness": "node scripts/check-freshness.mjs"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
